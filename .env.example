# ── SmritiSetu environment (copy to .env; never commit real secrets) ─────────

# App
APP_ENV=dev                      # dev | preview | staging | prod
APP_NAME=MindMitra
API_V1_PREFIX=/v1
LOG_LEVEL=INFO
# JSON list; replace local URLs with the deployed web origin outside development.
WEB_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Object storage (Backblaze B2 — images + text assets only)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=mindmitra-assets

# LLM (provider-abstracted; swappable)
LLM_PROVIDER=anthropic            # anthropic | openai | sarvam | local
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# Embeddings
EMBEDDINGS_MODEL=BAAI/bge-m3

# Speech (Bhashini / AI4Bharat)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Auth
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Crisis / escalation
TELE_MANAS_NUMBER=14416
