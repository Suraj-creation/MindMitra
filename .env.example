# GEMINI_API_KEY: Required for Gemini AI API calls (companion voice chat, memory reasoning, cognitive adaptation).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# DATABASE_URL: Neon PostgreSQL connection string (pooled connection recommended for serverless)
DATABASE_URL=

# DATABASE_URL_UNPOOLED: Neon PostgreSQL unpooled direct connection string
DATABASE_URL_UNPOOLED=

# NEON_BRANCH: Active Neon git-style branch (e.g. production, preview)
NEON_BRANCH=

# BACKBLAZE B2 OBJECT STORAGE (S3-Compatible)
# B2_APPLICATION_KEY_ID: Backblaze B2 keyID or applicationKeyId
B2_APPLICATION_KEY_ID=

# B2_APPLICATION_KEY: Backblaze B2 applicationKey secret
B2_APPLICATION_KEY=

# B2_BUCKET_NAME: Name of the bucket (e.g. mindmitra)
B2_BUCKET_NAME=

# B2_ENDPOINT: S3 endpoint URL for your Backblaze B2 region (e.g. https://s3.us-east-005.backblazeb2.com)
B2_ENDPOINT=

# B2_REGION: Bucket region (e.g. us-east-005)
B2_REGION=
