{
  "name": "mindmitra",
  "private": true,
  "version": "0.0.0",
  "description": "MindMitra / MindMitra \u2014 cognitive gaming & memory-assistance platform (SIH 2026, PS26003)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api:dev": "cd services/api && python -m uvicorn app.main:app --reload",
    "api:test": "cd services/api && python -m pytest -q",
    "gen:types": "pnpm gen:openapi && pnpm --filter @mindmitra/domain gen",
    "check:types": "pnpm gen:types && git diff --exit-code -- packages/domain/schema.d.ts",
    "gen:openapi": "python services/api/scripts/dump_openapi.py"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1"
  }
}
