{
  "mcpServers": {
    "backblaze-b2": {
      "command": "npx",
      "args": ["-y", "@backblaze-labs/b2-mcp@0.2.1"],
      "env": {
        "B2_APPLICATION_KEY_ID": "${B2_APPLICATION_KEY_ID}",
        "B2_APPLICATION_KEY": "${B2_APPLICATION_KEY}",
        "B2_DESTRUCTIVE_POLICY": "confirm"
      }
    }
  }
}