{
  "name": "@mindmitra/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types generated from the FastAPI OpenAPI schema. Never hand-written.",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ./openapi.json -o ./schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}
